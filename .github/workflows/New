1. malloc() Program

#include <stdio.h>
#include <stdlib.h>

int main() {
    int *ptr, i;

    ptr = (int *)malloc(5 * sizeof(int));

    if (ptr == NULL) {
        printf("Memory allocation failed");
        return 1;
    }

    printf("Enter 5 elements:\n");
    for (i = 0; i < 5; i++)
        scanf("%d", &ptr[i]);

    printf("Array elements are:\n");
    for (i = 0; i < 5; i++)
        printf("%d ", ptr[i]);

    free(ptr);
    ptr = NULL;

    return 0;
}


