# Ask for customer details
name = input("Enter customer name: ")
quantity = int(input("Enter number of coffees: "))
price = float(input("Enter price per coffee: "))

# Calculate total cost
total = quantity * price

# Calculate tax (5%)
tax = total * 0.05

# Final amount
final_amount = total + tax

# Print receipt
print("Thank you,", name, "!")
print("Your total for", quantity, "coffees, including tax, is $", final_amount)




