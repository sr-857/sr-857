phrase = input("Enter a phrase: ")
result = ""

for ch in phrase:
    if ch == " ":
        continue
    if ch.lower() in "aeiou":
        result += ch.upper()
    else:
        result += ch.lower()

print(result)# Lab Exercise 4: Modular Geometry Tool

def calculate_area(shape, dim1, dim2=0):
    if shape == "square":
        return dim1 * dim1
    elif shape == "rectangle":
        return dim1 * dim2
    elif shape == "triangle":
        return 0.5 * dim1 * dim2
    else:
        return "Invalid shape"

print(calculate_area("square", 5))
print(calculate_area("rectangle", 4, 6))
print(calculate_area("triangle", 3, 8))
