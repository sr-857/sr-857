# Lab Exercise 1: Tip & Split Calculator

bill = float(input("Enter total bill: "))
tip_percent = float(input("Enter tip percentage (e.g., 15, 20): "))
people = int(input("How many people are splitting? "))

tip_amount = bill * (tip_percent / 100)
total_bill = bill + tip_amount
per_person = total_bill / people

print(f"Each person must pay: ${per_person:.2f}")# Lab Exercise 2: Number Guessing Game

