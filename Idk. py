def calculate_pay(hours_worked, hourly_rate, bonus=0.0):
    if hours_worked > 40:
        overtime_hours = hours_worked - 40
        overtime_pay = overtime_hours * hourly_rate * 1.5
        regular_pay = 40 * hourly_rate
        total_pay = regular_pay + overtime_pay + bonus
    else:
        total_pay = (hours_worked * hourly_rate) + bonus

    return total_pay

# Function calls
pay1 = calculate_pay(45, 500)
print("Weekly Pay:", pay1)

pay2 = calculate_pay(hours_worked=38, hourly_rate=400, bonus=2000)
print("Weekly Pay:", pay2)
